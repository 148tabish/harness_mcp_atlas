# The one file to edit. `setup.sh` creates .env from this, reads it, and pushes
# what each component needs into its own config (vendor/zbridge/.env today).
# `run.sh` sources it before every run. Mode 600; never commit it.
#
# Leave a line empty to skip that route: a missing credential disables only the
# route that needs it.

# --- GLM routes (glm-5.3-flash, glm-5.3, glm-4.6v) -------------------------
# Your z.ai key. setup.sh copies it into vendor/zbridge/.env and generates the
# two bridge secrets there; you never edit that file by hand.
ZB_ZAI_API_KEY=

# --- GLM 5.3 on Bedrock (glm-5.3-bedrock) ----------------------------------
# A Bedrock API key (ABSK...) whose policy allows the application inference
# profile below, and that profile's ARN. setup.sh pushes them into
# vendor/bbridge/.env and generates the bridge secrets there.
BEDROCK_API_KEY=
BEDROCK_GLM_ARN=arn:aws:bedrock:ap-south-1:426628337772:application-inference-profile/jltum1pp47s7
BEDROCK_REGION=ap-south-1

# --- Claude route (opus-5) -------------------------------------------------
# Normally nothing here: the bridge uses the login in ~/.claude. Set this only
# for a token login.
# CLAUDE_CODE_OAUTH_TOKEN=

# --- Host and OS -------------------------------------------------------------
# Nothing here is needed on either OS: the bridges bind 0.0.0.0 and the task
# containers reach them as host.docker.internal on a Mac (Docker Desktop) and on a
# Linux engine (the compose template aliases it to the docker0 gateway).
# macOS only, optional: keep the Claude bridge off the LAN. Docker Desktop still
# reaches a loopback-bound port through host.docker.internal; a Linux engine would
# NOT, so leave this unset there.
# AURORA_CC_BRIDGE_HOST=127.0.0.1
# ZB_HOST=127.0.0.1
# macOS only: when the bridge refreshes the OAuth token it must write it back into
# the Keychain, or the interactive `claude` CLI is logged out on its next start.
# AURORA_CC_WRITE_BACK_KEYCHAIN=1

# --- Rubric judge ----------------------------------------------------------
# Rewardkit judges the rubric inside the verifier, through the codex CLI (ChatGPT
# login) or the claude-code CLI. The harness base64s ~/.codex/auth.json into the
# verifier itself; set CODEX_HOME only when the login lives somewhere else. Without
# a login the rubric channel is left out and runs score on the pytest ledger alone.
# The model used is recorded in every run's verifier/judge.json.
# CODEX_HOME=/home/ec2-user/.codex
# JUDGE_MODEL=gpt-5.6-sol        # default: config/models.yaml defaults.judge_model; a Pro
#                                # ChatGPT login accepts sol / terra / luna, a Plus login
#                                # only terra / luna (setup.sh probes it)
# JUDGE_TRANSPORT=codex          # or claude-code (needs CLAUDE_CODE_OAUTH_TOKEN above)

# --- ECR image fallback (optional) -----------------------------------------
# Without these the light-servers and verifier images build from source.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=ap-south-1

# --- Finance reporting (GLM 5.3 on Bedrock only) ----------------------------
# After each job the `finance` step POSTs one usage record per trial to the Odoo
# Finance API. Off by default. Opus-5 never posts: only the model keys listed in
# FINANCE_REPORT_MODELS do, and only while FINANCE_REPORT=true. Preview without
# sending: python -m harness.finance --job out/jobs/<job> --task-id <uuid> --model glm-5.3-bedrock --dry-run
# FINANCE_REPORT: true = post usage after each job; false = never
FINANCE_REPORT=false
# model keys (comma list) allowed to post
FINANCE_REPORT_MODELS=glm-5.3-bedrock
# https://<odoo-instance>; empty = skip even when FINANCE_REPORT=true
ODOO_URL=
# e.g. PRJ-512 (required when FINANCE_REPORT=true)
FINANCE_PROJECT_ID=
FINANCE_PROJECT_TYPE=Technical
FINANCE_TEAM_TYPE=Projects
# RFP | Production
FINANCE_BUDGET_TYPE=RFP
# Testing | Sampling (RFP only)
FINANCE_RFP_SUB_TYPE=Testing
# Singlephase | Multiphase (Production only)
FINANCE_PRODUCTION_MODE=
FINANCE_PHASE_NUMBER=1
# sent as given; empty for Bedrock (there is no Claude org to look up)
FINANCE_SUBSCRIPTION_ID=
# optional JSON merged into the request headers, e.g. {"Authorization": "Bearer <token>"}
# ODOO_EXTRA_HEADERS=
# default out/finance_ledger.jsonl
# FINANCE_LEDGER=
