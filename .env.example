# The one file to edit. `setup.sh` creates .env from this, reads it, and pushes
# what each component needs into its own config (vendor/zbridge/.env today).
# `run.sh` sources it before every run. Mode 600; never commit it.
#
# Leave a line empty to skip that route: a missing credential disables only the
# route that needs it.

# --- GLM routes (glm-5.3-flash, glm-5.3, glm-4.6v) -------------------------
# Your z.ai key. setup.sh copies it into vendor/zbridge/.env and generates the
# two bridge secrets there; you never edit that file by hand.
ZB_ZAI_API_KEY=

# --- Claude route (opus-5) -------------------------------------------------
# Normally nothing here: the bridge uses the login in ~/.claude. Set this only
# for a token login.
# CLAUDE_CODE_OAUTH_TOKEN=

# --- Rubric judge ----------------------------------------------------------
# The harness base64s ~/.codex/auth.json into the verifier itself. Set CODEX_HOME
# only when the codex login lives somewhere else. Without a login the rubric
# channel is dropped and runs score on Channel A alone.
# CODEX_HOME=/home/ec2-user/.codex
# JUDGE_MODEL=gpt-5.6-sol

# --- ECR image fallback (optional) -----------------------------------------
# Without these the light-servers and verifier images build from source.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=ap-south-1
